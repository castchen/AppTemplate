default_platform(:ios)

platform :ios do
  before_all do
    sh("xcodegen", "generate")
  end

  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY"),
      is_key_content_base64: false,
      in_house: false
    )
  end

  desc "Unsigned iOS Simulator build. Pull requests use xcodebuild directly."
  lane :build_simulator do
    sh(
      "xcodebuild",
      "-project", "AppTemplate.xcodeproj",
      "-scheme", "AppTemplate",
      "-configuration", "Debug",
      "-destination", "generic/platform=iOS Simulator",
      "CODE_SIGNING_ALLOWED=NO",
      "CODE_SIGNING_REQUIRED=NO",
      "CODE_SIGN_IDENTITY=",
      "build"
    )
  end

  desc "One-time writable Match sync. Does not archive or upload."
  lane :certificates do
    setup_ci if ENV["CI"]
    match(
      type: "appstore",
      readonly: false,
      api_key: asc_api_key,
      app_identifier: "com.example.apptemplate"
    )
  end

  desc "Match → gym → TestFlight. Readonly unless MATCH_READONLY=false."
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = asc_api_key
    readonly = ENV.fetch("MATCH_READONLY", "true") != "false"
    build_number = ENV.fetch("GITHUB_RUN_NUMBER", "1")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    profile_name = "match AppStore com.example.apptemplate"

    match(
      type: "appstore",
      readonly: readonly,
      api_key: api_key,
      app_identifier: "com.example.apptemplate"
    )

    gym(
      project: "AppTemplate.xcodeproj",
      scheme: "AppTemplate",
      configuration: "Release",
      export_method: "app-store",
      codesigning_identity: "Apple Distribution",
      clean: true,
      output_directory: "build",
      output_name: "AppTemplate.ipa",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: {
          "com.example.apptemplate" => profile_name
        }
      },
      xcargs: [
        "DEVELOPMENT_TEAM=#{team_id}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
